ENTRY_FIELDS = [("day", "Day"), ("project", "Project"), ("category", "Entry type"),
                ("time", "Time"), ("location", "Location"), ("description", "Description")]


# Questions that can be skipped; the description is always asked
ASK_FIELDS = [(key, label) for key, label in ENTRY_FIELDS if key != "description"]


def ask_flags(cfg):
    """`ask_every_time` per entry question; a question set to false is answered with its default."""
    flags = cfg.get("ask_every_time", {})
    return {key: flags.get(key, True) is not False for key, _ in ASK_FIELDS}


# Panel note for a question answered with its default because it isn't asked every time
SKIPPED = "(skipped)"


def ask_summary(asking, defaults):
    skipped = [label + (f" ({defaults.get('time')})" if key == "time" else "")
               for key, label in ASK_FIELDS if not asking[key]]
    return f"all but {', '.join(skipped)}" if skipped else "all questions"


def check_duration(raw):
    minutes = parse_duration(raw) if raw else None
    if not (minutes and 0 < minutes <= 24 * 60):
        raise ValueError("Couldn't read that as a duration between 1 minute and 24 hours, try again.")
    return minutes


def check_description(raw):
    if not raw:
        raise ValueError("A description is required.")
    if len(raw) > 255:
        raise ValueError(f"Too long ({len(raw)} characters), keep it to 255.")
    return raw


DAY_MINUTES = 8 * 60  # a full day, 100% on the day's progress bar
BAR_CELLS = 16        # half an hour per cell


def day_bar(mins):
    """Progress bar of `mins` against a full day: green, or orange past DAY_MINUTES."""
    full, half = divmod(min(mins, DAY_MINUTES) * BAR_CELLS * 2 // DAY_MINUTES, 2)
    bar = "█" * full + "▌" * half
    return f"{ORANGE if mins > DAY_MINUTES else GREEN}{bar}{RESET}{DIM}{'░' * (BAR_CELLS - len(bar))}{RESET}"


def week_of(date):
    monday = date - dt.timedelta(days=date.weekday())
    return [monday + dt.timedelta(days=i) for i in range(7)]


def entry_steps(cfg, form, st, asking):
    """Form steps for the entry questions, answered into `st`. The day is picked from
    `st["days"]`; answers already in `st` are pre-selected (and typed into the text
    questions' input line when `st["prefill"]`)."""
    defaults = cfg["defaults"]
    today = dt.date.today()
    projects = list(cfg["projects"])

    def logged(days):
        """Minutes already logged on each of `days`, leaving out the entry being edited."""
        mins = minutes_by_day(cfg, days[0], days[-1])
        if "entry" in st:
            e = st["entry"]
            mins[e["Date"]] = mins.get(e["Date"], 0) - e["Hours"] * 60 - e["Minutes"]
        return mins

    def logged_note(mins):
        return f"({fmt_minutes(mins)} already logged)" if mins else ""

    def day_text(date, mins):
        return f"{date:%A %d %b}" + (f"  {day_bar(mins)}" if form.live else "")

    def day():
        if not asking["day"]:
            st["date"] = today
            mins = logged([today]).get(today, 0)
            form.set("day", day_text(today, mins), " ".join(filter(None, [logged_note(mins), SKIPPED])))
            return SKIP
        days = st["days"]
        mins = logged(days)
        names = [f"{d:%A %d %b}" + ("  (today)" if d == today else "") for d in days]
        w = max(map(len, names))
        if form.live:  # hours first: the bar's colours end the highlighted row's colour
            labels = [f"{n:<{w}}  {fmt_minutes(mins[d]) if mins.get(d) else '':>5}  {day_bar(mins.get(d, 0))}"
                      for n, d in zip(names, days)]
        else:
            labels = [f"{n:<{w}}  {fmt_minutes(mins[d])} logged" if mins.get(d) else n
                      for n, d in zip(names, days)]
        label = form.select("day", "Which day is the timesheet for?", labels,
                            pick(days, st.get("date"), pick(days, today)))
        st["date"] = days[labels.index(label)]
        form.set("day", day_text(st["date"], mins.get(st["date"], 0)), logged_note(mins.get(st["date"], 0)))

    def project():
        if not asking["project"] and defaults["project"] in projects:
            st["project"] = defaults["project"]
            form.set("project", st["project"], SKIPPED)
            return SKIP
        st["project"] = form.select("project", "Which project?", projects,
                                    pick(projects, st.get("project"), pick(projects, defaults["project"])))

    def category():
        cats = cfg["projects"][st["project"]]["categories"]
        if not asking["category"] and defaults["category"] in cats:
            st["category"] = defaults["category"]
            form.set("category", st["category"], SKIPPED)
            return SKIP
        st["category"] = form.select("category", "What type of entry is it?", cats,
                                     pick(cats, st.get("category"), pick(cats, defaults["category"])))

    def time():
        # Rounded up to the next 15 minutes
        minutes = None
        if not asking["time"]:
            try:
                minutes = check_duration(str(defaults.get("time", "")))
            except ValueError:  # no usable default time: ask anyway
                pass
        skipped = minutes is not None
        if not skipped:
            minutes = form.ask("time", "Total time spent? (e.g. 1:20, 1h20, 80m, 1.5)", st.get("time", ""),
                               check=check_duration, prefill=st.get("prefill", False))
        rounded = math.ceil(minutes / 15) * 15
        st["hours"], st["mins"] = divmod(rounded, 60)
        st["time"] = f"{st['hours']}h{st['mins']:02d}"
        note = f"(rounded up from {minutes // 60}h{minutes % 60:02d})" if rounded != minutes else ""
        if skipped:
            form.set("time", st["time"], " ".join(filter(None, [note, SKIPPED])))
            return SKIP
        form.set("time", st["time"], note)
        if not form.live:
            print(f"  {GREEN}{st['time']}{RESET}{f' {DIM}{note}{RESET}' if note else ''}")

    def location():
        if not asking["location"] and defaults["location"] in cfg["locations"]:
            st["location"] = defaults["location"]
            form.set("location", st["location"], SKIPPED)
            return SKIP
        st["location"] = form.select("location", "Where did you work from?", cfg["locations"],
                                     pick(cfg["locations"], st.get("location"),
                                          pick(cfg["locations"], defaults["location"])))

    def description():
        st["description"] = form.ask("description", "Description? (max 255 characters)",
                                     st.get("description", ""), check=check_description,
                                     prefill=st.get("prefill", False))

    return [day, project, category, time, location, description]


def entry_values(cfg, st, sentiment, ticket=""):
    """Row values (keyed by column header) for the answers in `st`."""
    return {
        "Date": st["date"], "Project": st["project"], "Category": st["category"],
        "Hours": st["hours"], "Minutes": st["mins"], "Billable": cfg["projects"][st["project"]]["billable"],
        "Description": st["description"], "TicketNumber": ticket, "Sentiment": sentiment,
        "WorkedFrom": st["location"],
    }


def entry_summary(date, project, category, hours, mins, location):
    return f"{date:%a %d %b} · {project} / {category} · {hours}h{mins:02d} · {location}"


def log_entry(cfg, st=None):
    """Ask for one entry and save it. Answers already in `st` are pre-selected."""
    st = st if st is not None else {}
    st["days"] = week_of(dt.date.today())
    with Form(ENTRY_FIELDS) as form:
        form.run(entry_steps(cfg, form, st, ask_flags(cfg)))

    # Store
    path, = save_entries(cfg, [entry_values(cfg, st, cfg["defaults"]["sentiment"])])

    say(f"\n{GREEN}✔ Saved{RESET} " + entry_summary(st["date"], st["project"], st["category"],
                                                    st["hours"], st["mins"], st["location"]))
    say(f"{DIM}  → {path}{RESET}")


def another_entry():
    """Ask whether to log another entry (--multi). End of input counts as no."""
    question = "Log another entry? (Y/n)"
    with Form([]) as form:
        if form.live:
            return form.keypress(question, "y or enter another · n or q done",
                                 {b"y", b"Y", b"n", b"N", b"q", b"\r", b"\n"}) in (b"y", b"Y", b"\r", b"\n")
        try:
            return ask(question).lower() in ("", "y", "yes")
        except EOFError:
            print()
            return False


def log_entries(cfg):
    """--multi: log entries until the user says no. Each new entry starts from the previous
    one's day, project, entry type and location; the time and description are asked afresh."""
    saved = 0
    try:
        while True:
            st = {} if not saved else {k: st[k] for k in ("date", "project", "category", "location")}
            log_entry(cfg, st)
            saved += 1
            if not another_entry():
                break
            print()
    except (KeyboardInterrupt, EOFError):
        if not saved:
            raise
        say(f"\nCancelled, the current entry wasn't saved ({entries_text(saved)} saved before it).")
        sys.exit(130)
    if saved > 1:
        say(f"\n{GREEN}✔ {entries_text(saved)} saved{RESET}")


def entries_text(n):
    return f"{n} entr{'y' if n == 1 else 'ies'}"


# --- view entries ----------------------------------------------------------

# Extra panel rows shown while viewing an entry (dropped again when editing it)
VIEW_FIELDS = [("billable", "Billable"), ("sentiment", "Sentiment"), ("ticket", "Ticket"), ("file", "File")]


def month_range(today=None):
    """First and last day of the month `today` (default: today) is in."""
    today = today or dt.date.today()
    return today.replace(day=1), today.replace(day=calendar.monthrange(today.year, today.month)[1])


def entries_between(cfg, start, end):
    """(path, entry) for entries dated `start` to `end`, from every file those days fall in."""
    dates = [start + dt.timedelta(days=i) for i in range((end - start).days + 1)]
    found = []
    for path in dict.fromkeys(output_path(cfg, d) for d in dates):
        if os.path.exists(path):
            found += [(path, e) for e in read_entries(path) if start <= e["Date"] <= end]
    return found


def month_entries(cfg):
    """(path, entry) for entries from the current month, newest first."""
    found = entries_between(cfg, *month_range())
    return sorted(found, key=lambda pe: (pe[1]["Date"], pe[1]["_row"]), reverse=True)


def minutes_by_day(cfg, start, end):
    """Logged minutes per date from `start` to `end`, from every file those days fall in."""
    days = {}
    for _, e in entries_between(cfg, start, end):
        days[e["Date"]] = days.get(e["Date"], 0) + e["Hours"] * 60 + e["Minutes"]
    return days


def hours_table(cfg):
    """Boxed table of the time logged per day and per week in the current month (oldest week
    first), with the month's total. Days of a week outside the month are left blank."""
    today = dt.date.today()
    month, month_end = month_range(today)
    days = minutes_by_day(cfg, month, month_end)
    weekend = any(d.weekday() > 4 for d in days)
    names = ["Mon", "Tue", "Wed", "Thu", "Fri"] + (["Sat", "Sun"] if weekend else [])

    def cell(mins, style=""):
        return (fmt_minutes(mins), style) if mins else ("·", DIM)

    rows = [[("Week", BOLD)] + [(n, BOLD) for n in names] + [("Total", BOLD)]]
    monday = week_of(month)[0]
    while monday <= today:
        week = [monday + dt.timedelta(days=i) for i in range(7)]
        rows.append([(f"{max(monday, month):%d}–{min(week[-1], month_end):%d %b}", "")]
                    + [cell(days.get(d, 0), CYAN if d == today else "") if d.month == month.month else ("", "")
                       for d in week[:len(names)]]
                    + [cell(sum(days.get(d, 0) for d in week), BOLD)])
        monday += dt.timedelta(weeks=1)
    month_rows = [(f"{month:%B %Y}", cell(sum(v for d, v in days.items() if (d.year, d.month) == (month.year, month.month)),
                                          BOLD + GREEN))]

    widths = [max(len(r[i][0]) for r in rows) for i in range(len(rows[0]))]
    widths[1:-1] = [max(widths[1:-1] + [4])] * len(names)  # day columns share one width
    widths[-1] = max([widths[-1]] + [len(t[0]) for _, t in month_rows])
    span = sum(widths[:-1]) + 3 * (len(widths) - 2)  # month label spans every column but the total
    widths[0] += max(0, max(len(label) for label, _ in month_rows) - span)
    span = sum(widths[:-1]) + 3 * (len(widths) - 2)
    bar, segs = f"{DIM}│{RESET}", ["─" * (w + 2) for w in widths]

    def line(cells):
        out = []
        for i, ((text, style), w) in enumerate(zip(cells, widths)):
            text = f"{text:<{w}}" if i == 0 else f"{text:>{w}}"
            out.append(f"{style}{text}{RESET}" if style else text)
        return f"{bar} " + f" {bar} ".join(out) + f" {bar}"

    lines = [f"{DIM}╭{'┬'.join(segs)}╮{RESET}", line(rows[0]), f"{DIM}├{'┼'.join(segs)}┤{RESET}"]
    lines += [line(r) for r in rows[1:]]
    lines.append(f"{DIM}├{'┴'.join(segs[:-1])}┼{segs[-1]}┤{RESET}")
    for label, (text, style) in month_rows:
        lines.append(f"{bar} {label:<{span}} {bar} {style}{text:>{widths[-1]}}{RESET} {bar}")
    lines.append(f"{DIM}╰{'─' * (span + 2)}┴{segs[-1]}╯{RESET}")
    return lines


def view_entry(cfg):
    """Pick a recent entry and show it; e there changes its answers, d deletes it, and n in the list
    logs a new one. After a change is saved the list is shown again, with a changed or new entry
    highlighted; without a TTY it ends there."""
    found = month_entries(cfg)
    changed = None  # (path, row) of the entry to highlight after changing it
    while True:
        if not found:
            say(f"{DIM}No entries logged this month.{RESET}")
            return
        done = _view_form(cfg, found, changed)
        if done is None:
            return
        found = month_entries(cfg)
        changed = done if done != "deleted" else None
        if not (termios is not None and sys.stdin.isatty()):
            return
        print()


def _view_form(cfg, found, changed=None):
    """One pass of `view_entry`: week, list, show, edit. The list starts on the entry at `changed`.
    Returns None when done viewing, else "deleted" or the (path, row) of the changed or new entry."""
    labels = []
    for _, e in found:
        desc = e.get("Description", "")
        desc = desc if len(desc) <= 40 else desc[:39] + "…"
        labels.append(f"{e['Date']:%a %d %b} · {e.get('Project', '?')} / {e.get('Category', '?')} · "
                      f"{e['Hours']}h{e['Minutes']:02d} · {desc}")
        while labels.count(labels[-1]) > 1:  # menus return the label, so keep them unique
            labels[-1] += " ·"
    st = {}
    month, month_end = month_range()
    weeks = sorted({week_of(e["Date"])[0] for _, e in found})  # their Mondays, oldest first
    week_labels = []
    for monday in weeks:
        in_week = [e for _, e in found if week_of(e["Date"])[0] == monday]
        week_labels.append(f"{max(monday, month):%d}–{min(monday + dt.timedelta(days=6), month_end):%d %b} · "
                           f"{entries_text(len(in_week))} · "
                           f"{fmt_minutes(sum(e['Hours'] * 60 + e['Minutes'] for e in in_week))}")
    view = {"week": weeks[-1]}

    def show_fields():
        e = st["entry"]
        form.fields = ENTRY_FIELDS + VIEW_FIELDS
        for key, col in (("billable", "Billable"), ("sentiment", "Sentiment"), ("ticket", "TicketNumber")):
            form.set(key, str(e.get(col, "")))
        form.set("file", st["path"].replace(os.path.expanduser("~"), "~", 1))

    def sure_delete():
        if form.live:
            return form.keypress("Delete this entry? (y/N)", "y delete · n or enter keep it",
                                 {b"y", b"Y", b"n", b"N", b"\r", b"\n"}) in (b"y", b"Y")
        return ask("Delete this entry? (y/N)").lower() in ("y", "yes")

    def week():
        """The week of the month to list entries from; skipped the first time round after a change
        (the list opens on the changed entry's week)."""
        form.fields = []  # the hours table is shown above the menus instead of the panel
        if not form.live:
            print("\n".join(form.table) + "\n")
        if view.pop("skip", False):
            return None  # not SKIP, so Back from the list still comes here
        label = form.select(None, "Which week?", week_labels, weeks.index(view["week"]))
        view["week"] = weeks[week_labels.index(label)]

    def choose():
        """The list; e or d there edits or deletes the highlighted entry without showing it first,
        n logs a new entry (asking the questions set to be asked every time)."""
        shown = [label for label, (_, e) in zip(labels, found) if week_of(e["Date"])[0] == view["week"]]
        while True:
            form.fields = []
            asking.update(dict.fromkeys(asking, True))  # editing asks every question
            label, action = form.select(None, "Which entry?", shown,
                                        shown.index(st["label"]) if st.get("label") in shown else 0,
                                        actions={b"e": "edit", b"d": "delete", b"n": "new"})
            if action == "new":
                asking.update(ask_flags(cfg))
                st.clear()
                st.update(new=True, label=label, days=week_of(dt.date.today()))
                form.values.clear()
                form.fields = ENTRY_FIELDS
                return steps.index(show) + 1
            pick_entry(label)
            if action == "edit":
                form.fields = ENTRY_FIELDS
                return steps.index(show) + 1
            if action != "delete":
                return None
            show_fields()
            if sure_delete():
                st["delete"] = True
                return len(steps)

    def pick_entry(label):
        path, e = found[labels.index(label)]
        st.clear()
        st.update(label=label, path=path, entry=e, prefill=True, days=week_of(e["Date"]), date=e["Date"],
                  project=e.get("Project", ""), category=e.get("Category", ""),
                  time=f"{e['Hours']}h{e['Minutes']:02d}", location=e.get("WorkedFrom", ""),
                  description=e.get("Description", ""))
        for key, value in (("day", f"{e['Date']:%A %d %b}"), ("project", st["project"]),
                           ("category", st["category"]), ("time", st["time"]),
                           ("location", st["location"]), ("description", st["description"])):
            form.set(key, value)

    def show():
        show_fields()
        if not form.live:
            label_w = max(len(label) for _, label in form.fields)
            for key, label in form.fields:
                print(f"  {DIM}{label:<{label_w}}{RESET}  {form.values.get(key, ('', ''))[0] or '—'}")
        st["delete"] = False
        while True:
            if form.live:
                k = form.keypress("What would you like to do?",
                                  "e edit · d delete · 0 or b back to the list · enter or q done",
                                  {b"e", b"E", b"d", b"D", b"0", b"b", b"q", b"\r", b"\n"}).decode().lower()
                if k in "0b":
                    raise Back
            else:
                k = ask("e to edit, d to delete, enter to finish").lower()[:1]
            if k != "d":
                break
            if sure_delete():
                st["delete"] = True
                return len(steps)
        if k != "e":
            st["viewed"] = True
            return len(steps)
        form.fields = ENTRY_FIELDS

    asking = {key: True for key, _ in ASK_FIELDS}
    with Form([]) as form:
        form.table = hours_table(cfg)
        steps = [week, choose, show] + entry_steps(cfg, form, st, asking)
        match = [(label, e) for label, (path, e) in zip(labels, found) if (path, e["_row"]) == changed]
        if match:
            st["label"] = match[0][0]
            view.update(week=week_of(match[0][1]["Date"])[0], skip=True)
        form.run(steps)

    if st.get("viewed"):
        return None
    if st.get("new"):
        path, = save_entries(cfg, [entry_values(cfg, st, cfg["defaults"]["sentiment"])])
        say(f"\n{GREEN}✔ Saved{RESET} " + entry_summary(st["date"], st["project"], st["category"],
                                                        st["hours"], st["mins"], st["location"]))
        say(f"{DIM}  → {path}{RESET}")
        return path, max(n["_row"] for n in read_entries(path))
    path, e = st["path"], st["entry"]
    template = template_path(cfg)
    if st.get("delete"):
        update_row(path, template, e["_row"])
        say(f"\n{GREEN}✔ Deleted{RESET} " + entry_summary(e["Date"], e.get("Project", "?"), e.get("Category", "?"),
                                                        e["Hours"], e["Minutes"], e.get("WorkedFrom", "?")))
        say(f"{DIM}  from {path}{RESET}")
        return "deleted"
    values = entry_values(cfg, st, e.get("Sentiment", cfg["defaults"]["sentiment"]), e.get("TicketNumber", ""))
    row = e["_row"]
    if output_path(cfg, st["date"]) == path:
        update_row(path, template, row, values)
    else:  # the new day belongs in another week's/month's file
        update_row(path, template, row)
        path, = save_entries(cfg, [values])
        row = max(n["_row"] for n in read_entries(path))
    say(f"\n{GREEN}✔ Updated{RESET} " + entry_summary(st["date"], st["project"], st["category"],
                                                      st["hours"], st["mins"], st["location"]))
    say(f"{DIM}  → {path}{RESET}")
    return path, row


# --- hours summary ---------------------------------------------------------

HOURS_FLAGS = {"--hours-day": "day", "--hours-week": "week", "--hours-month": "month"}
KNOWN_FLAGS = {"-h", "--help", "--setup", "--export", "--list", "--hours", "--multi", *HOURS_FLAGS}
SHORT_FLAGS = {"-s": "--setup", "-m": "--multi", "-e": "--export", "-l": "--list", "-H": "--hours"}


def fmt_minutes(total):
    return f"{total // 60}h{total % 60:02d}"


def show_hours(cfg, period=None):
    """Logged time for today, this week or this month, per project and category, with a total."""
    if period is None:
        choices = {"Today": "day", "This week": "week", "This month": "month"}
        with Form([]) as form:
            period = choices[form.select(None, "Show hours for?", list(choices))]
        say(f"{DIM}Tip: osheet --hours-day, --hours-week or --hours-month skips this question{RESET}\n")

    today = dt.date.today()
    if period == "day":
        start = end = today
        title, span = "Today", f"({today:%a %d %b})"
    elif period == "week":
        start = today - dt.timedelta(days=today.weekday())
        end = start + dt.timedelta(days=6)
        title, span = "This week", f"({start:%a %d %b} – {end:%a %d %b})"
    else:
        start = today.replace(day=1)
        end = (start + dt.timedelta(days=32)).replace(day=1) - dt.timedelta(days=1)
        title, span = "This month", f"({start:%B %Y})"
    dates = [start + dt.timedelta(days=i) for i in range((end - start).days + 1)]

    # A week or month can span several files; each holds only entries from its own period
    totals = {}
    for path in dict.fromkeys(output_path(cfg, d) for d in dates):
        if not os.path.exists(path):
            continue
        for e in read_entries(path):
            if start <= e["Date"] <= end:
                cats = totals.setdefault(e.get("Project", "?"), {})
                cat = e.get("Category", "?")
                cats[cat] = cats.get(cat, 0) + e["Hours"] * 60 + e["Minutes"]

    if not totals:
        say(f"{BOLD}{title} {DIM}{span}{RESET}\n")
        say(f"{DIM}  No entries logged {'today' if period == 'day' else 'this ' + period} yet.{RESET}")
        return
    # Boxed table: one group per project (busiest first), with a subtotal when it has several categories
    groups = []
    for project, cats in sorted(totals.items(), key=lambda kv: -sum(kv[1].values())):
        rows = [(project if i == 0 else "", cat, fmt_minutes(mins), "")
                for i, (cat, mins) in enumerate(sorted(cats.items(), key=lambda kv: -kv[1]))]
        if len(rows) > 1:
            rows.append(("", "Subtotal", fmt_minutes(sum(cats.values())), BOLD))
        groups.append(rows)
    total = ("Total", "", fmt_minutes(sum(sum(c.values()) for c in totals.values())), BOLD + GREEN)
    header = ("Project", "Category", "Time", BOLD)
    widths = [max(len(r[i]) for g in groups + [[header, total]] for r in g) for i in range(3)]
    heading = f"{title} {span}"
    widths[1] += max(0, len(heading) - (sum(widths) + 6))  # widen so the heading row fits
    if sys.stdout.isatty():
        # Too wide for the terminal: narrow the widest text column, its cells wrap
        over = sum(widths) + 12 - (shutil.get_terminal_size().columns - 1)
        while over > 0 and max(widths[:2]) > 4:
            widths[widths[1] > widths[0]] -= 1
            over -= 1

    def rule(left, mid, right):
        return f"  {DIM}{left}{mid.join('─' * (w + 2) for w in widths)}{right}{RESET}"

    def line(project, cat, time, style):
        """Table row; cells too long for their column wrap onto extra lines."""
        bar = f"{DIM}│{RESET}"
        cols = [wrap(text, w, indent=0) for text, w in zip((project, cat, time), widths)]
        out = []
        for i in range(max(map(len, cols))):
            part = [c[i] if i < len(c) else "" for c in cols]
            cells = [f"{part[0]:<{widths[0]}}", f"{part[1]:<{widths[1]}}", f"{part[2]:>{widths[2]}}"]
            if style and not project:  # subtotal: highlight only the category and time
                cells[1:] = [f"{style}{c}{RESET}" for c in cells[1:]]
            elif style:
                cells = [f"{style}{c}{RESET}" for c in cells]
            elif project:
                cells[0] = f"{BOLD}{cells[0]}{RESET}"
            out.append(f"  {bar} " + f" {bar} ".join(cells) + f" {bar}")
        return "\n".join(out)

    inner = sum(widths) + 6
    print(f"  {DIM}╭{'─' * (inner + 2)}╮{RESET}")
    for part in wrap(f"{BOLD}{title}{RESET} {DIM}{span}{RESET}", inner, indent=0):
        pad = inner - len(ANSI_RE.sub("", part))
        print(f"  {DIM}│{RESET} {' ' * (pad // 2)}{part}{' ' * (pad - pad // 2)} {DIM}│{RESET}")
    print(rule("├", "┬", "┤"))
    print(line(*header))
    for rows in groups:
        print(rule("├", "┼", "┤"))
        for row in rows:
            print(line(*row))
    print(rule("├", "┼", "┤"))
    print(line(*total))
    print(rule("╰", "┴", "╯"))

def copy_to_clipboard(text):
    """Copy text using the platform's clipboard tool. Returns the tool used, or None."""
    if sys.platform == "darwin":
        candidates = [["pbcopy"]]
    elif sys.platform == "win32":
        candidates = [["clip"]]
    else:
        candidates = []
        if os.environ.get("WAYLAND_DISPLAY"):
            candidates.append(["wl-copy"])
        candidates += [["xclip", "-selection", "clipboard"], ["xsel", "--clipboard", "--input"]]
    for cmd in candidates:
        if shutil.which(cmd[0]):
            try:
                subprocess.run(cmd, input=text.encode(), check=True, timeout=5,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return cmd[0]
            except (OSError, subprocess.SubprocessError):
                continue
    return None


def show_dir(cfg):
    folder = os.path.dirname(output_path(cfg, dt.date.today()))
    url = "file://" + urllib.parse.quote(folder.replace(os.sep, "/"))
    # OSC 8 hyperlink: clickable in most modern terminals, plain text elsewhere
    print(f"\033]8;;{url}\033\\{BOLD}{folder}{RESET}\033]8;;\033\\")
    if not os.path.isdir(folder):
        say(f"{DIM}  (doesn't exist yet; it's created when you log your first entry){RESET}")
    tool = copy_to_clipboard(folder)
    if tool:
        say(f"{GREEN}✔ Copied folder path to clipboard{RESET}")
    else:
        say(f"{DIM}  No clipboard tool found (install wl-clipboard, xclip or xsel); copy the path above.{RESET}")


def main(argv):
    argv = [SHORT_FLAGS.get(a, a) for a in argv]
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__.strip())
        return
    unknown = [a for a in argv if a not in KNOWN_FLAGS]
    if unknown:
        print(f"osheet: unrecognised argument(s): {' '.join(unknown)}", file=sys.stderr)
        print("Run 'osheet --help' for usage.", file=sys.stderr)
        sys.exit(2)
    cfg = load_config()
    if cfg is not None and "group_by" not in cfg:
        with Form([("group_by", "Group files")]) as form:
            cfg["group_by"] = ask_group_by(form)
        save_config(cfg)
        print()
    if cfg is not None and cfg.get("ask_every_time") != ask_flags(cfg):
        cfg["ask_every_time"] = ask_flags(cfg)
        save_config(cfg)
    if cfg is not None:
        cfg = migrate_csv(cfg)
        migrate_ungrouped(cfg)
        migrate_file_names(cfg)
    if cfg is None or "--setup" in argv:
        if cfg is None:
            say("No config found, let's set osheet up first.\n")
        setup(cfg)
        return
    if "--export" in argv:
        show_dir(cfg)
        return
    if "--list" in argv:
        view_entry(cfg)
        return
    if "--hours" in argv or any(a in HOURS_FLAGS for a in argv):
        show_hours(cfg, next((HOURS_FLAGS[a] for a in argv if a in HOURS_FLAGS), None))
        return
    if "--multi" in argv:
        log_entries(cfg)
        return
    log_entry(cfg)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (KeyboardInterrupt, EOFError):
        say("\nCancelled, nothing saved.")
        sys.exit(130)
