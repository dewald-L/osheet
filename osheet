#!/usr/bin/env python3
"""osheet - log timesheet entries to an Excel file based on a TimesheetUpload.xlsx template.

Usage:
    osheet                log an entry (runs setup instead if there is no config yet)
    osheet -s, --setup    (re)run the configuration step
    osheet -e, --export   copy the timesheet folder path to the clipboard
    osheet -H, --hours    show logged hours per category for today, this week or this month
                          (-d/--hours-day, -w/--hours-week, -m/--hours-month skip the question)
    osheet -h, --help     show this help
"""

import csv
import datetime as dt
import json
import math
import os
import posixpath
import re
import shutil
import subprocess
import sys
import urllib.parse
import xml.etree.ElementTree as ET
import zipfile

try:
    import termios
    import tty
except ImportError:  # Windows: menus fall back to numbered input
    termios = tty = None

DEFAULT_COLUMNS = ["Date", "Project", "Category", "Hours", "Minutes", "Billable",
                   "Description", "TicketNumber", "Sentiment", "WorkedFrom"]
DEFAULT_LOCATIONS = ["Home", "Office", "Client", "Other"]
DEFAULT_SENTIMENTS = ["Neutral", "Happy", "Sad"]
# Only the folder is configurable; files are named after their week/month (see grouped_path)
OUTPUT_NAME = "TimesheetUpload.xlsx"
DEFAULT_OUTPUT = os.path.join("~", "timesheets", OUTPUT_NAME)
DEFAULT_TEMPLATE = os.path.join("~", "Downloads", "TimesheetUpload.xlsx")

BOLD, DIM, CYAN, GREEN, RED, MAGENTA, RESET = (
    "\033[1m", "\033[2m", "\033[36m", "\033[32m", "\033[31m", "\033[35m", "\033[0m")


# --- config ----------------------------------------------------------------

def config_dir():
    if sys.platform == "win32":
        base = os.environ.get("APPDATA") or os.path.expanduser(r"~\AppData\Roaming")
    elif sys.platform == "darwin":
        base = os.path.expanduser("~/Library/Application Support")
    else:
        base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "osheet")


CONFIG_PATH = os.path.join(config_dir(), "config.json")


def load_config():
    try:
        with open(CONFIG_PATH) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    with open(CONFIG_PATH, "w") as f:
        json.dump(cfg, f, indent=2)


# --- template --------------------------------------------------------------

NS = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
REL_NS = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}"


def read_xlsx(path):
    """Return {sheet name: [ {column letter: value} per row ]} using only the standard library."""
    with zipfile.ZipFile(path) as z:
        strings = []
        if "xl/sharedStrings.xml" in z.namelist():
            for si in ET.fromstring(z.read("xl/sharedStrings.xml")).iter(NS + "si"):
                strings.append("".join(t.text or "" for t in si.iter(NS + "t")))
        rels = {r.get("Id"): r.get("Target")
                for r in ET.fromstring(z.read("xl/_rels/workbook.xml.rels"))}
        sheets = {}
        for s in ET.fromstring(z.read("xl/workbook.xml")).iter(NS + "sheet"):
            target = rels[s.get(REL_NS + "id")].lstrip("/")
            target = target if target.startswith("xl/") else posixpath.join("xl", target)
            rows = []
            for r in ET.fromstring(z.read(target)).iter(NS + "row"):
                row = {}
                for c in r.iter(NS + "c"):
                    v = c.find(NS + "v")
                    if v is None:
                        is_ = c.find(NS + "is")
                        if is_ is None:
                            continue
                        val = "".join(t.text or "" for t in is_.iter(NS + "t"))
                    else:
                        val = strings[int(v.text)] if c.get("t") == "s" else v.text
                    row[re.match(r"[A-Z]+", c.get("r")).group()] = val
                rows.append(row)
            sheets[s.get("name")] = rows
    return sheets


def column_values(rows, header):
    """All non-empty values below `header` in the first row."""
    if not rows:
        return []
    col = next((k for k, v in rows[0].items() if v == header), None)
    return [r[col] for r in rows[1:] if col and r.get(col)] if col else []


def parse_template(path):
    sheets = read_xlsx(path)
    lookup = sheets.get("Lookup")
    if not lookup:
        raise ValueError("no 'Lookup' sheet found")
    head = {v: k for k, v in lookup[0].items()}
    if not {"Project", "Category"} <= head.keys():
        raise ValueError("'Lookup' sheet needs Project and Category columns")

    projects, current = {}, None
    for r in lookup[1:]:
        current = r.get(head["Project"], current)
        cat = r.get(head["Category"])
        if not current or not cat:
            continue
        p = projects.setdefault(current, {"billable": "No", "categories": []})
        p["categories"].append(cat)
        if r.get(head.get("Billable")) == "Yes":
            p["billable"] = "Yes"
    if not projects:
        raise ValueError("no projects found in the 'Lookup' sheet")

    entry = next((rows for name, rows in sheets.items() if name not in ("Lookup", "Validation")), [])
    columns = list(entry[0].values()) if entry else DEFAULT_COLUMNS
    validation = sheets.get("Validation", [])
    locations = [v for v in column_values(validation, "WorkedFrom") if v != "NotSet"] or DEFAULT_LOCATIONS
    sentiments = column_values(validation, "Sentiment") or DEFAULT_SENTIMENTS
    return {"columns": columns, "projects": projects, "locations": locations, "sentiments": sentiments}


# --- workbook output -------------------------------------------------------

TEMPLATE_COPY = os.path.join(config_dir(), "template.xlsx")
EXCEL_EPOCH = dt.date(1899, 12, 30)


def store_template(src):
    """Keep a private copy of the template so the original can be moved or deleted."""
    os.makedirs(os.path.dirname(TEMPLATE_COPY), exist_ok=True)
    if os.path.abspath(src) != os.path.abspath(TEMPLATE_COPY):
        shutil.copyfile(src, TEMPLATE_COPY)


def template_path(cfg):
    if not os.path.exists(TEMPLATE_COPY):
        store_template(cfg["template"])
    return TEMPLATE_COPY


def entry_sheet_parts(files):
    """Return (sheet xml path, [table xml paths]) for the timesheet entry sheet."""
    rels = {r.get("Id"): r.get("Target") for r in ET.fromstring(files["xl/_rels/workbook.xml.rels"])}
    for s in ET.fromstring(files["xl/workbook.xml"]).iter(NS + "sheet"):
        if s.get("name") in ("Lookup", "Validation"):
            continue
        target = rels[s.get(REL_NS + "id")].lstrip("/")
        sheet = target if target.startswith("xl/") else posixpath.join("xl", target)
        folder, name = posixpath.split(sheet)
        sheet_rels = posixpath.join(folder, "_rels", name + ".rels")
        tables = []
        if sheet_rels in files:
            for r in ET.fromstring(files[sheet_rels]):
                if r.get("Type", "").endswith("/table"):
                    tables.append(posixpath.normpath(posixpath.join(folder, r.get("Target"))))
        return sheet, tables
    raise ValueError("no timesheet entry sheet found")


def xml_escape(text):
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def shared_string_index(files, text, cache):
    """Index of `text` in sharedStrings.xml, appending it if needed."""
    if not cache:
        sst = ET.fromstring(files["xl/sharedStrings.xml"])
        for i, si in enumerate(sst.iter(NS + "si")):
            cache.setdefault("".join(t.text or "" for t in si.iter(NS + "t")), i)
    if text not in cache:
        xml = files["xl/sharedStrings.xml"].decode("utf-8")
        xml = xml.replace("</sst>", f'<si><t xml:space="preserve">{xml_escape(text)}</t></si></sst>')
        files["xl/sharedStrings.xml"] = xml.encode("utf-8")
        cache[text] = len(cache)
    return cache[text]


def date_style_index(files):
    """Index of a cellXfs style with a built-in date format, adding one if needed."""
    xml = files["xl/styles.xml"].decode("utf-8")
    block = re.search(r"<cellXfs[^>]*>(.*?)</cellXfs>", xml, re.S)
    xfs = re.findall(r"<xf\b[^>]*?(?:/>|>.*?</xf>)", block.group(1), re.S)
    for i, xf in enumerate(xfs):
        if 'numFmtId="14"' in xf:
            return i
    new = '<xf numFmtId="14" applyNumberFormat="1" fontId="0" applyFont="1" xfId="0" />'
    xml = xml[:block.end(1)] + new + xml[block.end(1):]
    xml = re.sub(r'(<cellXfs[^>]*count=")\d+', rf"\g<1>{len(xfs) + 1}", xml, count=1)
    files["xl/styles.xml"] = xml.encode("utf-8")
    return len(xfs)


def append_rows(path, template, entries):
    """Append entries (dicts keyed by column header) to the workbook at `path`,
    creating it from `template` if it doesn't exist yet."""
    src = path if os.path.exists(path) else template
    with zipfile.ZipFile(src) as z:
        infos = z.infolist()
        files = {i.filename: z.read(i.filename) for i in infos}

    sheet_path, table_paths = entry_sheet_parts(files)
    sheet = ET.fromstring(files[sheet_path])
    rows = list(sheet.iter(NS + "row"))
    letters = {}
    for c in rows[0].iter(NS + "c"):
        v = c.find(NS + "v")
        if v is not None and c.get("t") == "s":
            text = ET.fromstring(files["xl/sharedStrings.xml"]).findall(NS + "si")[int(v.text)]
            letters["".join(t.text or "" for t in text.iter(NS + "t"))] = re.match(r"[A-Z]+", c.get("r")).group()
    date_col = letters.get("Date", "A")
    last_col = max(letters.values(), key=lambda s: (len(s), s))

    xml = files[sheet_path].decode("utf-8")
    last = int(rows[-1].get("r"))
    # The template ships with a placeholder row 2 (defaults only, no date): replace it
    if last == 2 and not any(re.match(rf"{date_col}2$", c.get("r")) for c in rows[-1].iter(NS + "c")):
        xml = re.sub(r'<row r="2"[^>]*?(?:/>|>.*?</row>)', "", xml, flags=re.S)
        last = 1

    cache, date_style, new_rows = {}, date_style_index(files), []
    for n, entry in enumerate(entries, start=last + 1):
        cells = []
        for header, col in sorted(letters.items(), key=lambda kv: (len(kv[1]), kv[1])):
            value = entry.get(header)
            if value in (None, ""):
                continue
            ref = f"{col}{n}"
            if isinstance(value, dt.date):
                cells.append(f'<c r="{ref}" s="{date_style}"><v>{(value - EXCEL_EPOCH).days}</v></c>')
            elif isinstance(value, (int, float)):
                cells.append(f'<c r="{ref}" s="0"><v>{value}</v></c>')
            else:
                idx = shared_string_index(files, str(value), cache)
                cells.append(f'<c r="{ref}" s="0" t="s"><v>{idx}</v></c>')
        new_rows.append(f'<row r="{n}">{"".join(cells)}</row>')
    end = last + len(entries)

    xml = xml.replace("</sheetData>", "".join(new_rows) + "</sheetData>")
    xml = re.sub(r'(<dimension ref=")[^"]*', rf"\g<1>A1:{last_col}{end}", xml)
    xml = re.sub(r'sqref="([A-Z]+)2:\1\d+"', rf'sqref="\g<1>2:\g<1>{end}"', xml)
    files[sheet_path] = xml.encode("utf-8")
    for t in table_paths:
        txml = files[t].decode("utf-8")
        txml = re.sub(r'ref="([A-Z]+)1:([A-Z]+)\d+"', rf'ref="\g<1>1:\g<2>{end}"', txml)
        files[t] = txml.encode("utf-8")

    sst = files["xl/sharedStrings.xml"].decode("utf-8")
    total = len(re.findall(r"<si>", sst))
    sst = re.sub(r'uniqueCount="\d+"', f'uniqueCount="{total}"', sst, count=1)
    sst = re.sub(r'(<sst[^>]*?) count="\d+"', rf'\g<1> count="{total}"', sst, count=1)
    files["xl/sharedStrings.xml"] = sst.encode("utf-8")

    tmp = path + ".tmp"
    with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as z:
        for info in infos:
            z.writestr(info, files[info.filename])
    os.replace(tmp, path)


GROUP_OPTIONS = {
    "week": "Week (one file per Mon–Sun week)",
    "month": "Month (one file per calendar month)",
}


def ask_group_by(form, current="week"):
    labels = list(GROUP_OPTIONS.values())
    choice = form.select("group_by", "Would you like to group timesheet export files by week, or by month?",
                         labels, pick(list(GROUP_OPTIONS), current))
    group_by = list(GROUP_OPTIONS)[labels.index(choice)]
    form.set("group_by", f"by {group_by}")
    return group_by


def group_label(group_by, date):
    if group_by == "month":
        return f"{date:%Y-%m}"
    # dd-dd_Month, e.g. 05-11_October for Mon 5 – Sun 11 Oct (month of the Monday)
    monday = date - dt.timedelta(days=date.weekday())
    sunday = monday + dt.timedelta(days=6)
    return f"{monday:%d}-{sunday:%d}_{monday:%B}"


def output_path(cfg, date=None):
    """The Excel file an entry for `date` goes into (OSHEET_FILE overrides grouping)."""
    if os.environ.get("OSHEET_FILE"):
        return os.path.abspath(os.path.expanduser(os.environ["OSHEET_FILE"]))
    base = os.path.abspath(os.path.expanduser(cfg["output"]))
    if date is None or not cfg.get("group_by"):
        return base
    return grouped_path(base, cfg["group_by"], date)


def grouped_path(base, group_by, date):
    """<folder>/<yyyy_Month>/<period>.xlsx; a week is filed under the month of its Monday."""
    start = date - dt.timedelta(days=date.weekday()) if group_by == "week" else date
    return os.path.join(os.path.dirname(base), f"{start:%Y}_{start:%B}", f"{group_label(group_by, date)}.xlsx")


def save_entries(cfg, entries):
    """Append entries to their (grouped) files. Returns the paths written."""
    by_path = {}
    for e in entries:
        by_path.setdefault(output_path(cfg, e["Date"]), []).append(e)
    for path, group in by_path.items():
        os.makedirs(os.path.dirname(path), exist_ok=True)
        append_rows(path, template_path(cfg), group)
    return list(by_path)


def read_entries(path):
    """Entries (dicts keyed by column header) from a timesheet workbook."""
    sheets = read_xlsx(path)
    rows = next(r for name, r in sheets.items() if name not in ("Lookup", "Validation"))
    headers = rows[0]
    entries = []
    for row in rows[1:]:
        e = {headers[col]: val for col, val in row.items() if col in headers}
        if not e.get("Date"):
            continue
        e["Date"] = EXCEL_EPOCH + dt.timedelta(days=int(float(e["Date"])))
        for k in ("Hours", "Minutes"):
            e[k] = int(float(e.get(k) or 0))
        entries.append(e)
    return entries


def migrate_ungrouped(cfg):
    """One-off: split a single pre-grouping Excel file into week/month files."""
    old = os.path.abspath(os.path.expanduser(cfg["output"]))
    if os.environ.get("OSHEET_FILE") or not cfg.get("group_by") or not os.path.exists(old):
        return
    entries = read_entries(old)
    paths = save_entries(cfg, entries)
    os.replace(old, old + ".bak")
    where = ", ".join(os.path.basename(p) for p in paths) or "nowhere (it was empty)"
    say(f"{DIM}Moved {len(entries)} entries from {os.path.basename(old)} into {where} "
          f"(old file kept as {os.path.basename(old)}.bak){RESET}\n")


def migrate_file_names(cfg):
    """One-off: rename <name>_<period>.xlsx files (and the old dd-dd_MM week label) to <period>.xlsx."""
    if os.environ.get("OSHEET_FILE") or not cfg.get("group_by"):
        return
    folder = os.path.dirname(os.path.abspath(os.path.expanduser(cfg["output"])))
    old = re.compile(r".+_(?:(\d\d-\d\d)_(\d\d|[A-Z][a-z]+)|(\d{4}-\d\d))\.xlsx")
    for sub in sorted(os.listdir(folder)) if os.path.isdir(folder) else []:
        sub = os.path.join(folder, sub)
        if not re.fullmatch(r"\d{4}_[A-Z][a-z]+", os.path.basename(sub)) or not os.path.isdir(sub):
            continue
        for f in sorted(os.listdir(sub)):
            m = old.fullmatch(f)
            if not m:
                continue
            if m[3]:
                new = f"{m[3]}.xlsx"
            elif m[2].isdigit():
                if not 1 <= int(m[2]) <= 12:
                    continue
                new = f"{m[1]}_{dt.date(2000, int(m[2]), 1):%B}.xlsx"
            else:
                new = f"{m[1]}_{m[2]}.xlsx"
            if not os.path.exists(os.path.join(sub, new)):
                os.replace(os.path.join(sub, f), os.path.join(sub, new))
                say(f"{DIM}Renamed {f} → {new}{RESET}")


def migrate_csv(cfg):
    """One-off: move entries from an old CSV output into the Excel file."""
    old = os.path.expanduser(cfg["output"])
    if not old.lower().endswith(".csv"):
        return cfg
    cfg["output"] = cfg["output"][:-4] + ".xlsx"
    if os.path.exists(old):
        with open(old, newline="") as f:
            entries = list(csv.DictReader(f))
        for e in entries:
            e["Date"] = dt.date.fromisoformat(e["Date"])
            for k in ("Hours", "Minutes"):
                e[k] = int(e[k])
        paths = save_entries(cfg, entries)
        os.replace(old, old + ".bak")
        where = ", ".join(paths) or "nowhere (it was empty)"
        say(f"{DIM}Moved {len(entries)} entries from {old} → {where} (old file kept as .csv.bak){RESET}\n")
    save_config(cfg)
    return cfg


# --- prompts ---------------------------------------------------------------

def pick(options, preferred, fallback=0):
    """Index of `preferred` in options, else `fallback`."""
    return options.index(preferred) if preferred in options else fallback


def read_key(fd):
    ch = os.read(fd, 1)
    if ch == b"\x1b":
        ch += os.read(fd, 2)
    return ch


def select_numbered(question, options, default=0):
    """Numbered menu, used when there is no TTY (pipes, Windows)."""
    print(f"{BOLD}? {question}{RESET}")
    for i, o in enumerate(options, 1):
        print(f"  {i}. {o}{'  (default)' if i - 1 == default else ''}")
    ans = input("> ").strip()
    return options[int(ans) - 1] if ans.isdigit() and 0 < int(ans) <= len(options) else options[default]


def _menu_loop(fd, options, default, draw, window=10, back=False, checked=None):
    """Arrow-key menu: ↑/↓ or j/k move, space/enter or a number picks that option, typing filters.
    With `checked` (a list of bools, changed in place) it is a checklist instead: space or a
    number toggles an option and enter submits. `draw(lines)` renders it.
    Returns the chosen option (True for a checklist), or None for "Back"."""
    idx, query, number = default, "", ""
    width = len(str(len(options)))
    while True:
        view = [i for i, o in enumerate(options) if query.lower() in o.lower()] or list(range(len(options)))
        rows = view + ([None] if back else [])
        idx = min(idx, len(rows) - 1)
        top = max(0, min(min(idx, len(view) - 1) - window // 2, len(view) - window))
        lines = []
        for pos in range(top, min(top + window, len(view))):
            box = "" if checked is None else f"[{'x' if checked[view[pos]] else ' '}] "
            text = f"{view[pos] + 1:>{width}}. {box}{options[view[pos]]}"
            lines.append(f"{CYAN}❯ {text}{RESET}" if pos == idx else f"  {text}")
        if back:
            text = f"{0:>{width}}. ← Back"
            lines.append(f"{CYAN}❯ {text}{RESET}" if idx == len(view) else f"  {DIM}{text}{RESET}")
        pick_word = "toggle" if checked is not None else "select"
        if number:
            hint = f"{DIM}  number: {RESET}{number}{DIM} · space to {pick_word}{RESET}"
        elif query:
            hint = f"{DIM}  filter: {RESET}{query}"
        elif checked is not None:
            hint = f"{DIM}  ↑/↓ or j/k move · space or number toggle · enter done · type to filter{RESET}"
        else:
            hint = f"{DIM}  ↑/↓ or j/k move · space, enter or number select · type to filter{RESET}"
        lines.append(hint)
        draw(lines)

        k = read_key(fd)
        typed, number = number, ""
        if checked is not None and k in (b"\r", b"\n"):
            return True if rows[idx] is not None else None
        if k in (b" ", b"\r", b"\n"):
            if rows[idx] is None:
                return None
            if checked is None:
                return options[rows[idx]]
            checked[rows[idx]] = not checked[rows[idx]]
        elif k == b"\x1b[A" or (k == b"k" and not query):
            idx = (idx - 1) % len(rows)
        elif k == b"\x1b[B" or (k == b"j" and not query):
            idx = (idx + 1) % len(rows)
        elif k in (b"\x7f", b"\x08"):
            if not typed:
                query, idx = query[:-1], 0
        elif len(k) == 1 and k.isdigit():
            if back and not typed and k == b"0":
                return None
            # Pick as soon as the number can't grow into another visible option's number
            typed += k.decode()
            matches = [pos for pos, i in enumerate(view) if str(i + 1).startswith(typed)]
            exact = [pos for pos in matches if str(view[pos] + 1) == typed]
            if exact and len(matches) == 1:
                idx = exact[0]
                if checked is None:
                    return options[view[idx]]
                checked[view[idx]] = not checked[view[idx]]
            elif matches:
                idx, number = (exact or matches)[0], typed
        elif len(k) == 1 and 32 < k[0] < 127:
            query, idx = query + k.decode(), 0


def ask(question, default=""):
    suffix = f" {DIM}({default}){RESET}" if default else ""
    ans = input(f"{BOLD}? {question}{RESET}{suffix} ").strip()
    return ans or default


ANSI_RE = re.compile(r"\033\[[0-9;?]*[A-Za-z]")


def wrap(line, width, indent=None, hard=True):
    """Word-wrap `line` to `width` visible characters, keeping its ANSI styles across the breaks.
    Continuation lines are indented by `indent`; by default to the text after a leading marker
    (`? `, `❯ `, `3. `, `[x] `). Words longer than a line are split when `hard`, else left whole."""
    chars, style = [], ""
    for part in re.split(f"({ANSI_RE.pattern})", line):
        if ANSI_RE.fullmatch(part):
            style = "" if part == RESET else style + part
        else:
            chars += [(c, style) for c in part]
    text = "".join(c for c, _ in chars)
    if len(text) <= width:
        return [line]
    if indent is None:
        indent = len(re.match(r"\s*(?:[?❯>]\s+)?(?:\d+\.\s+)?(?:\[.\]\s+)?", text)[0])
    indent = indent if width - indent >= 12 else 0
    spans, start, room = [], 0, width
    while len(text) - start > room:
        cut = text.rfind(" ", max(start, indent) + 1, start + room + 1)  # not inside the label/marker
        if cut <= start:
            cut = start + room if hard else text.find(" ", start + room)
            if cut == -1:
                break
        if not hard:  # a word too long for a whole line stays where it is, the terminal wraps it
            nxt = len(text) - len(text[cut:].lstrip(" "))
            end = text.find(" ", nxt)
            if (len(text) if end == -1 else end) - nxt > width - indent:
                break
        spans.append((start, cut))
        start = cut
        while start < len(text) and text[start] == " ":
            start += 1
        room = width - indent
    spans.append((start, len(text)))
    out = []
    for n, (a, b) in enumerate(spans):
        piece, cur = " " * indent if n else "", ""
        for c, st in chars[a:b]:
            if st != cur:
                piece += RESET + st if cur else st
                cur = st
            piece += c
        out.append(piece + (RESET if cur else ""))
    return out


def say(text=""):
    """print(), word-wrapped to the terminal's width when printing to one."""
    if sys.stdout.isatty():
        cols = shutil.get_terminal_size().columns
        text = "\n".join(p for line in text.split("\n") for p in wrap(line, cols - 1, hard=False))
    print(text)


class Back(Exception):
    """Raised by a Form question when the user chooses to go back."""


SKIP = object()  # returned by a step that answered itself without asking; Back passes over it


class Form:
    """Panel of `Label  value` lines that redraws in place as questions are answered,
    with the current question drawn below it. Without a TTY, questions and answers
    are printed as plain lines instead."""

    def __init__(self, fields):
        self.fields = fields   # [(key, label)]
        self.values = {}       # key -> (text, note)
        self.active = None
        self.drawn = 0         # lines from the top of the panel down to the cursor
        self.live = termios is not None and sys.stdin.isatty()
        self.can_back = False

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        # Done or cancelled: clear the question area and leave the panel on screen
        if self.live:
            self.redraw()

    def run(self, steps):
        """Run question steps in order. Going back from a question re-runs the step before it;
        a step may return the index of the step to run next, or SKIP."""
        i, history = 0, []
        while i < len(steps):
            self.can_back = self.live and bool(history)
            try:
                nxt = steps[i]()
            except Back:
                i = history.pop()
                continue
            if nxt is SKIP:
                i += 1
                continue
            history.append(i)
            i = i + 1 if nxt is None else nxt
        self.can_back = False

    def set(self, key, text, note=""):
        if key is not None:
            self.values[key] = (text, note)
        self.active = None

    def render(self, width):
        """Panel lines, boxed to `width` columns."""
        if not self.fields:
            return []
        label_w = max(len(label) for _, label in self.fields)
        inner = width - 4
        lines = [f"{DIM}╭{'─' * (width - 2)}╮{RESET}"]
        for key, label in self.fields:
            text, note = self.values.get(key, ("", ""))
            value = text + (f" {DIM}{note}{RESET}" if note else "") if text else f"{DIM}—{RESET}"
            if key == self.active:
                row = f"{CYAN}❯ {label:<{label_w}}  {BOLD}{value}{RESET}"
            else:
                row = f"  {DIM}{label:<{label_w}}{RESET}  {BOLD}{value}{RESET}"
            for piece in wrap(row, inner, indent=label_w + 4):
                piece += " " * (inner - len(ANSI_RE.sub("", piece)))
                lines.append(f"{DIM}│{RESET} {piece} {DIM}│{RESET}")
        lines.append(f"{DIM}╰{'─' * (width - 2)}╯{RESET}")
        return lines

    @staticmethod
    def width():
        return max(20, min(shutil.get_terminal_size().columns - 1, 80))

    def redraw(self, question=()):
        """Redraw the panel plus `question` lines over what was drawn before."""
        cols = shutil.get_terminal_size().columns
        gap = [""] if self.fields and question else []
        lines = [piece for line in self.render(self.width()) + gap + list(question)
                 for piece in wrap(line, cols - 1)]
        up = f"\033[{self.drawn}A" if self.drawn else ""
        sys.stdout.write("\r" + up + "".join(f"\033[2K{line}\n" for line in lines) + "\033[J")
        sys.stdout.flush()
        self.drawn = len(lines)

    def _menu(self, key, question, options, default, checked=None, summary=None):
        """Run `_menu_loop` under the panel (TTY only). `summary()`, if given, is the
        panel value for `key`, refreshed on every redraw."""
        self.active = key
        header = f"{BOLD}{MAGENTA}? {question}{RESET}"
        size = shutil.get_terminal_size()
        room = (size.lines - len(self.render(self.width())) - 6 - self.can_back
                - (len(wrap(header, size.columns - 1)) - 1))

        def draw(lines):
            if summary:
                self.values[key] = (summary(), "")
            self.redraw([header, ""] + lines)

        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        tty.setcbreak(fd)
        sys.stdout.write("\033[?25l")
        try:
            choice = _menu_loop(fd, options, default, draw, window=max(3, min(10, room)),
                                back=self.can_back, checked=checked)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
            sys.stdout.write("\033[?25h")
        if choice is None:
            raise Back
        return choice

    def select(self, key, question, options, default=0):
        """Menu for `key`, drawn under the panel."""
        if not self.live:
            choice = select_numbered(question, options, default)
        else:
            choice = self._menu(key, question, options, default)
        self.set(key, choice)
        return choice

    def checklist(self, key, question, options, checked, summary):
        """Checklist for `key` (TTY only): space toggles, enter submits. `checked` is
        changed in place; `summary()` is the panel value, updated as options are toggled."""
        self._menu(key, question, options, 0, checked=checked, summary=summary)
        self.set(key, summary())

    def ask(self, key, question, default="", check=None):
        """Text input for `key`, drawn under the panel. `check(answer)` returns the value to
        use or raises ValueError, whose message is shown under the question before asking again."""
        error = ""
        while True:
            if self.live:
                self.active = key
                suffix = f" {DIM}({default}){RESET}" if default else ""
                suffix += f" {DIM}· enter < to go back{RESET}" if self.can_back else ""
                self.redraw([f"{BOLD}{MAGENTA}? {question}{RESET}{suffix}"] + ([f"  {error}"] if error else []))
                raw = input(f"  {CYAN}❯{RESET} ")
                # The input line (wrapped if long) now sits above the cursor too
                self.drawn += (4 + len(raw) - 1) // shutil.get_terminal_size().columns + 1
                if self.can_back and raw.strip() == "<":
                    raise Back
                ans = raw.strip() or default
            else:
                if error:
                    print(f"  {error}")
                ans = ask(question, default)
            try:
                value = check(ans) if check else ans
                break
            except ValueError as e:
                error = str(e)
        self.set(key, ans)
        return value


def parse_duration(text):
    """Return minutes. Accepts 1:30, 1h30, 1h 30m, 90m, 1.5h, 1.5 (hours), 90 (minutes if > 24)."""
    t = text.strip().lower().replace(" ", "")
    if m := re.fullmatch(r"(\d+):(\d{1,2})", t):
        return int(m[1]) * 60 + int(m[2])
    if m := re.fullmatch(r"(?:(\d+(?:\.\d+)?)h)?(?:(\d+)m?)?", t):
        if m[1] is None and m[2] is None:
            return None
        if m[1] is not None:
            return round(float(m[1]) * 60) + int(m[2] or 0)
        n = int(m[2])
        return n if t.endswith("m") or n > 24 else n * 60
    if m := re.fullmatch(r"(\d*\.\d+)", t):
        return round(float(m[1]) * 60)
    return None


