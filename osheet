HOURS_FLAGS = {"--hours-day": "day", "--hours-week": "week", "--hours-month": "month"}
KNOWN_FLAGS = {"-h", "--help", "--setup", "--export", "--hours", *HOURS_FLAGS}
SHORT_FLAGS = {"-s": "--setup", "-e": "--export", "-H": "--hours",
               "-d": "--hours-day", "-w": "--hours-week", "-m": "--hours-month"}


def fmt_minutes(total):
    return f"{total // 60}h{total % 60:02d}"


def show_hours(cfg, period=None):
    """Logged time for today, this week or this month, per project and category, with a total."""
    if period is None:
        choices = {"Today": "day", "This week": "week", "This month": "month"}
        with Form([]) as form:
            period = choices[form.select(None, "Show hours for?", list(choices))]
        say(f"{DIM}Tip: osheet --hours-day, --hours-week or --hours-month skips this question{RESET}\n")

    today = dt.date.today()
    if period == "day":
        start = end = today
        title, span = "Today", f"({today:%a %d %b})"
    elif period == "week":
        start = today - dt.timedelta(days=today.weekday())
        end = start + dt.timedelta(days=6)
        title, span = "This week", f"({start:%a %d %b} – {end:%a %d %b})"
    else:
        start = today.replace(day=1)
        end = (start + dt.timedelta(days=32)).replace(day=1) - dt.timedelta(days=1)
        title, span = "This month", f"({start:%B %Y})"
    dates = [start + dt.timedelta(days=i) for i in range((end - start).days + 1)]

    # A week or month can span several files; each holds only entries from its own period
    totals = {}
    for path in dict.fromkeys(output_path(cfg, d) for d in dates):
        if not os.path.exists(path):
            continue
        for e in read_entries(path):
            if start <= e["Date"] <= end:
                cats = totals.setdefault(e.get("Project", "?"), {})
                cat = e.get("Category", "?")
                cats[cat] = cats.get(cat, 0) + e["Hours"] * 60 + e["Minutes"]

    if not totals:
        say(f"{BOLD}{title} {DIM}{span}{RESET}\n")
        say(f"{DIM}  No entries logged {'today' if period == 'day' else 'this ' + period} yet.{RESET}")
        return
    # Boxed table: one group per project (busiest first), with a subtotal when it has several categories
    groups = []
    for project, cats in sorted(totals.items(), key=lambda kv: -sum(kv[1].values())):
        rows = [(project if i == 0 else "", cat, fmt_minutes(mins), "")
                for i, (cat, mins) in enumerate(sorted(cats.items(), key=lambda kv: -kv[1]))]
        if len(rows) > 1:
            rows.append(("", "Subtotal", fmt_minutes(sum(cats.values())), BOLD))
        groups.append(rows)
    total = ("Total", "", fmt_minutes(sum(sum(c.values()) for c in totals.values())), BOLD + GREEN)
    header = ("Project", "Category", "Time", BOLD)
    widths = [max(len(r[i]) for g in groups + [[header, total]] for r in g) for i in range(3)]
    heading = f"{title} {span}"
    widths[1] += max(0, len(heading) - (sum(widths) + 6))  # widen so the heading row fits
    if sys.stdout.isatty():
        # Too wide for the terminal: narrow the widest text column, its cells wrap
        over = sum(widths) + 12 - (shutil.get_terminal_size().columns - 1)
        while over > 0 and max(widths[:2]) > 4:
            widths[widths[1] > widths[0]] -= 1
            over -= 1

    def rule(left, mid, right):
        return f"  {DIM}{left}{mid.join('─' * (w + 2) for w in widths)}{right}{RESET}"

    def line(project, cat, time, style):
        """Table row; cells too long for their column wrap onto extra lines."""
        bar = f"{DIM}│{RESET}"
        cols = [wrap(text, w, indent=0) for text, w in zip((project, cat, time), widths)]
        out = []
        for i in range(max(map(len, cols))):
            part = [c[i] if i < len(c) else "" for c in cols]
            cells = [f"{part[0]:<{widths[0]}}", f"{part[1]:<{widths[1]}}", f"{part[2]:>{widths[2]}}"]
            if style and not project:  # subtotal: highlight only the category and time
                cells[1:] = [f"{style}{c}{RESET}" for c in cells[1:]]
            elif style:
                cells = [f"{style}{c}{RESET}" for c in cells]
            elif project:
                cells[0] = f"{BOLD}{cells[0]}{RESET}"
            out.append(f"  {bar} " + f" {bar} ".join(cells) + f" {bar}")
        return "\n".join(out)

    inner = sum(widths) + 6
    print(f"  {DIM}╭{'─' * (inner + 2)}╮{RESET}")
    for part in wrap(f"{BOLD}{title}{RESET} {DIM}{span}{RESET}", inner, indent=0):
        pad = inner - len(ANSI_RE.sub("", part))
        print(f"  {DIM}│{RESET} {' ' * (pad // 2)}{part}{' ' * (pad - pad // 2)} {DIM}│{RESET}")
    print(rule("├", "┬", "┤"))
    print(line(*header))
    for rows in groups:
        print(rule("├", "┼", "┤"))
        for row in rows:
            print(line(*row))
    print(rule("├", "┼", "┤"))
    print(line(*total))
    print(rule("╰", "┴", "╯"))

def copy_to_clipboard(text):
    """Copy text using the platform's clipboard tool. Returns the tool used, or None."""
    if sys.platform == "darwin":
        candidates = [["pbcopy"]]
    elif sys.platform == "win32":
        candidates = [["clip"]]
    else:
        candidates = []
        if os.environ.get("WAYLAND_DISPLAY"):
            candidates.append(["wl-copy"])
        candidates += [["xclip", "-selection", "clipboard"], ["xsel", "--clipboard", "--input"]]
    for cmd in candidates:
        if shutil.which(cmd[0]):
            try:
                subprocess.run(cmd, input=text.encode(), check=True, timeout=5,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return cmd[0]
            except (OSError, subprocess.SubprocessError):
                continue
    return None


def show_dir(cfg):
    folder = os.path.dirname(output_path(cfg, dt.date.today()))
    url = "file://" + urllib.parse.quote(folder.replace(os.sep, "/"))
    # OSC 8 hyperlink: clickable in most modern terminals, plain text elsewhere
    print(f"\033]8;;{url}\033\\{BOLD}{folder}{RESET}\033]8;;\033\\")
    if not os.path.isdir(folder):
        say(f"{DIM}  (doesn't exist yet; it's created when you log your first entry){RESET}")
    tool = copy_to_clipboard(folder)
    if tool:
        say(f"{GREEN}✔ Copied folder path to clipboard{RESET}")
    else:
        say(f"{DIM}  No clipboard tool found (install wl-clipboard, xclip or xsel); copy the path above.{RESET}")


def main(argv):
    argv = [SHORT_FLAGS.get(a, a) for a in argv]
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__.strip())
        return
    unknown = [a for a in argv if a not in KNOWN_FLAGS]
    if unknown:
        print(f"osheet: unrecognised argument(s): {' '.join(unknown)}", file=sys.stderr)
        print("Run 'osheet --help' for usage.", file=sys.stderr)
        sys.exit(2)
    cfg = load_config()
    if cfg is not None and "group_by" not in cfg:
        with Form([("group_by", "Group files")]) as form:
            cfg["group_by"] = ask_group_by(form)
        save_config(cfg)
        print()
    if cfg is not None and cfg.get("ask_every_time") != ask_flags(cfg):
        cfg["ask_every_time"] = ask_flags(cfg)
        save_config(cfg)
    if cfg is not None:
        cfg = migrate_csv(cfg)
        migrate_ungrouped(cfg)
        migrate_file_names(cfg)
    if cfg is None or "--setup" in argv:
        if cfg is None:
            say("No config found, let's set osheet up first.\n")
        setup(cfg)
        return
    if "--export" in argv:
        show_dir(cfg)
        return
    if "--hours" in argv or any(a in HOURS_FLAGS for a in argv):
        show_hours(cfg, next((HOURS_FLAGS[a] for a in argv if a in HOURS_FLAGS), None))
        return
    log_entry(cfg)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (KeyboardInterrupt, EOFError):
        say("\nCancelled, nothing saved.")
        sys.exit(130)
