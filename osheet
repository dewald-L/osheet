def load_template(raw):
    """(path, parsed template) for a path typed by the user; ValueError if it can't be used."""
    template = os.path.abspath(os.path.expanduser(raw.strip().strip("'\"")))
    try:
        return template, parse_template(template)
    except FileNotFoundError:
        raise ValueError(f"{RED}File not found:{RESET} {template}")
    except (zipfile.BadZipFile, KeyError, ValueError) as e:
        raise ValueError(f"{RED}Couldn't read that template:{RESET} {e}")


SETUP_FIELDS = [("template", "Template"), ("project", "Project"), ("category", "Entry type"),
                ("location", "Location"), ("sentiment", "Sentiment"), ("ask", "Ask every time"),
                ("group_by", "Group files"),
                ("output", "Save to")]


def setup(existing=None):
    existing = existing or {}
    say(f"{BOLD}osheet setup{RESET} {DIM}(config: {CONFIG_PATH}){RESET}\n")
    with Form(SETUP_FIELDS) as form:
        st = _setup_form(form, existing)

    store_template(st["template"])
    cfg = {"template": st["template"], "output": st["output"], "group_by": st["group_by"],
           "defaults": st["defaults"], "ask_every_time": st["ask"], **st["data"]}
    save_config(cfg)
    if form.live:
        print()
    say(f"{GREEN}✔ Config saved{RESET} {DIM}→ {CONFIG_PATH}{RESET}\n")
    say(f"You're all set. Log a timesheet entry by running: {BOLD}osheet{RESET}")
    say(f"{DIM}Copy the timesheet folder path with: osheet --export{RESET}")
    say(f"{DIM}Change these settings any time with: osheet --setup{RESET}")


def _setup_form(form, existing):
    st = {"output": os.path.join(os.path.dirname(existing.get("output", "")) or os.path.dirname(DEFAULT_OUTPUT),
                                 OUTPUT_NAME), "group_by": existing.get("group_by", "week"),
          "ask": ask_flags(existing)}

    def template():
        suggested = st.get("template") or existing.get("template") or DEFAULT_TEMPLATE
        st["template"], data = form.ask("template", "Path to the timesheet template (.xlsx)?", suggested,
                                        check=load_template)
        st["data"] = data
        n_cats = sum(len(p["categories"]) for p in data["projects"].values())
        shown = st["template"].replace(os.path.expanduser("~"), "~", 1)
        form.set("template", shown, f"({len(data['projects'])} projects, {n_cats} entry types)")
        if not form.live:
            print(f"  {GREEN}Found {len(data['projects'])} projects, {n_cats} entry types{RESET}\n")

        # Proposed defaults: keep previous choices where still valid
        projects = list(data["projects"])
        old = st.get("defaults") or existing.get("defaults", {})
        billable = [p for p in projects if data["projects"][p]["billable"] == "Yes"]
        project = old.get("project") if old.get("project") in projects else (billable or projects)[0]
        cats = data["projects"][project]["categories"]
        st["defaults"] = {
            "project": project,
            "category": cats[pick(cats, old.get("category"), pick(cats, "Software Development"))],
            "location": data["locations"][pick(data["locations"], old.get("location"),
                                               pick(data["locations"], "Home"))],
            "sentiment": data["sentiments"][pick(data["sentiments"], old.get("sentiment"),
                                                 pick(data["sentiments"], "Neutral"))],
        }
        if old.get("time"):
            st["defaults"]["time"] = old["time"]

    def confirm():
        defaults, group_by = st["defaults"], st["group_by"]
        example = grouped_path(st["output"], group_by, dt.date.today())
        for key in ("project", "category", "location", "sentiment"):
            form.set(key, defaults[key])
        form.set("ask", ask_summary(st["ask"], defaults))
        form.set("group_by", f"by {group_by}")
        form.set("output", example, "(e.g.)")
        if not form.live:
            print(f"{BOLD}Defaults:{RESET}")
            print(f"  Project     {CYAN}{defaults['project']}{RESET}")
            print(f"  Entry type  {CYAN}{defaults['category']}{RESET}")
            print(f"  Location    {CYAN}{defaults['location']}{RESET}")
            print(f"  Sentiment   {CYAN}{defaults['sentiment']}{RESET}")
            print(f"  Ask         {CYAN}{ask_summary(st['ask'], defaults)}{RESET}")
            print(f"  Group files {CYAN}by {group_by}{RESET}")
            print(f"  Save to     {CYAN}{example}{RESET} {DIM}(e.g.){RESET}\n")
        answer = form.select(None, "Use these defaults?", ["Yes, save", "Change them"])
        return len(steps) if answer.startswith("Yes") else None

    def default_of(key, question, options):
        def step():
            st["defaults"][key] = form.select(key, question, options(), pick(options(), st["defaults"][key]))
        return step

    def ask_every_time():
        asking = st["ask"]
        options = lambda: [f"[{'x' if asking[key] else ' '}] {label}" for key, label in ASK_FIELDS] + ["Done"]
        idx = len(ASK_FIELDS)
        if form.live:
            keys = [key for key, _ in ASK_FIELDS]
            checked = [asking[key] for key in keys]
            form.checklist("ask", "Which questions should be asked every time? "
                                  "(unticked ones use the default)", [label for _, label in ASK_FIELDS],
                           checked, lambda: ask_summary(dict(zip(keys, checked)), st["defaults"]))
            asking.update(zip(keys, checked))
        while not form.live:
            form.set("ask", ask_summary(asking, st["defaults"]))
            choice = form.select("ask", "Which questions should be asked every time? "
                                        "(pick one to tick/untick; unticked ones use the default)", options(), idx)
            idx = options().index(choice)
            if choice == "Done":
                break
            key = ASK_FIELDS[idx][0]
            asking[key] = not asking[key]
        if not asking["time"]:
            # Time has no default otherwise
            def check(raw):
                check_duration(raw)
                return raw
            st["defaults"]["time"] = form.ask("ask", "Default time when it isn't asked? (e.g. 1h, 1:30)",
                                              st["defaults"].get("time", ""), check=check)
        form.set("ask", ask_summary(asking, st["defaults"]))

    def group_by():
        st["group_by"] = ask_group_by(form, st["group_by"])

    def output():
        def check(raw):
            folder = raw.strip().strip("'\"")
            if not folder:
                raise ValueError(f"{RED}Enter a folder{RESET}")
            if os.path.isfile(os.path.expanduser(folder)):
                raise ValueError(f"{RED}That's a file, not a folder:{RESET} {folder}")
            if not folder.startswith("~"):
                folder = os.path.abspath(folder)
            return os.path.join(folder, OUTPUT_NAME)
        st["output"] = form.ask("output", "Folder to save timesheets in? (one file per week/month)",
                                os.path.dirname(st["output"]), check=check)
        if not form.live:
            print()
        return steps.index(confirm)

    data = lambda: st["data"]
    steps = [
        template, confirm,
        default_of("project", "Default project?", lambda: list(data()["projects"])),
        default_of("category", "Default entry type?",
                   lambda: data()["projects"][st["defaults"]["project"]]["categories"]),
        default_of("location", "Default location?", lambda: data()["locations"]),
        default_of("sentiment", "Default sentiment?", lambda: data()["sentiments"]),
        ask_every_time, group_by, output,
    ]
    form.run(steps)
    return st


# --- log entry -------------------------------------------------------------

ENTRY_FIELDS = [("day", "Day"), ("project", "Project"), ("category", "Entry type"),
                ("time", "Time"), ("location", "Location"), ("description", "Description")]


# Questions that can be skipped; the description is always asked
ASK_FIELDS = [(key, label) for key, label in ENTRY_FIELDS if key != "description"]


def ask_flags(cfg):
    """`ask_every_time` per entry question; a question set to false is answered with its default."""
    flags = cfg.get("ask_every_time", {})
    return {key: flags.get(key, True) is not False for key, _ in ASK_FIELDS}


# Panel note for a question answered with its default because it isn't asked every time
SKIPPED = "(skipped)"


def ask_summary(asking, defaults):
    skipped = [label + (f" ({defaults.get('time')})" if key == "time" else "")
               for key, label in ASK_FIELDS if not asking[key]]
    return f"all but {', '.join(skipped)}" if skipped else "all questions"


def check_duration(raw):
    minutes = parse_duration(raw) if raw else None
    if not (minutes and 0 < minutes <= 24 * 60):
        raise ValueError("Couldn't read that as a duration between 1 minute and 24 hours, try again.")
    return minutes


def check_description(raw):
    if not raw:
        raise ValueError("A description is required.")
    if len(raw) > 255:
        raise ValueError(f"Too long ({len(raw)} characters), keep it to 255.")
    return raw


def log_entry(cfg):
    defaults = cfg["defaults"]
    today = dt.date.today()
    monday = today - dt.timedelta(days=today.weekday())
    days = [monday + dt.timedelta(days=i) for i in range(7)]
    labels = [f"{d:%A %d %b}" + ("  (today)" if d == today else "") for d in days]

    projects = list(cfg["projects"])
    asking = ask_flags(cfg)
    st = {}

    def day():
        if not asking["day"]:
            st["date"] = today
            form.set("day", f"{today:%A %d %b}", SKIPPED)
            return SKIP
        label = form.select("day", "Which day is the timesheet for?", labels,
                            pick(days, st.get("date"), today.weekday()))
        st["date"] = days[labels.index(label)]
        form.set("day", f"{st['date']:%A %d %b}")

    def project():
        if not asking["project"] and defaults["project"] in projects:
            st["project"] = defaults["project"]
            form.set("project", st["project"], SKIPPED)
            return SKIP
        st["project"] = form.select("project", "Which project?", projects,
                                    pick(projects, st.get("project"), pick(projects, defaults["project"])))

    def category():
        cats = cfg["projects"][st["project"]]["categories"]
        if not asking["category"] and defaults["category"] in cats:
            st["category"] = defaults["category"]
            form.set("category", st["category"], SKIPPED)
            return SKIP
        st["category"] = form.select("category", "What type of entry is it?", cats,
                                     pick(cats, st.get("category"), pick(cats, defaults["category"])))

    def time():
        # Rounded up to the next 15 minutes
        minutes = None
        if not asking["time"]:
            try:
                minutes = check_duration(str(defaults.get("time", "")))
            except ValueError:  # no usable default time: ask anyway
                pass
        skipped = minutes is not None
        if not skipped:
            minutes = form.ask("time", "Total time spent? (e.g. 1:20, 1h20, 80m, 1.5)", st.get("time", ""),
                               check=check_duration)
        rounded = math.ceil(minutes / 15) * 15
        st["hours"], st["mins"] = divmod(rounded, 60)
        st["time"] = f"{st['hours']}h{st['mins']:02d}"
        note = f"(rounded up from {minutes // 60}h{minutes % 60:02d})" if rounded != minutes else ""
        if skipped:
            form.set("time", st["time"], " ".join(filter(None, [note, SKIPPED])))
            return SKIP
        form.set("time", st["time"], note)
        if not form.live:
            print(f"  {GREEN}{st['time']}{RESET}{f' {DIM}{note}{RESET}' if note else ''}")

    def location():
        if not asking["location"] and defaults["location"] in cfg["locations"]:
            st["location"] = defaults["location"]
            form.set("location", st["location"], SKIPPED)
            return SKIP
        st["location"] = form.select("location", "Where did you work from?", cfg["locations"],
                                     pick(cfg["locations"], st.get("location"),
                                          pick(cfg["locations"], defaults["location"])))

    def description():
        st["description"] = form.ask("description", "Description? (max 255 characters)",
                                     st.get("description", ""), check=check_description)

    with Form(ENTRY_FIELDS) as form:
        form.run([day, project, category, time, location, description])

    # Store
    date, hours, mins = st["date"], st["hours"], st["mins"]
    values = {
        "Date": date, "Project": st["project"], "Category": st["category"],
        "Hours": hours, "Minutes": mins, "Billable": cfg["projects"][st["project"]]["billable"],
        "Description": st["description"], "TicketNumber": "", "Sentiment": defaults["sentiment"],
        "WorkedFrom": st["location"],
    }
    path, = save_entries(cfg, [values])

    say(f"\n{GREEN}✔ Saved{RESET} {date:%a %d %b} · {st['project']} / {st['category']} · "
          f"{hours}h{mins:02d} · {st['location']}")
    say(f"{DIM}  → {path}{RESET}")


