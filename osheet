    print(f"{DIM}Copy the timesheet folder path with: osheet --export{RESET}")
    print(f"{DIM}Change these settings any time with: osheet --setup{RESET}")


def _setup_form(form, existing):
    st = {"output": existing.get("output", DEFAULT_OUTPUT), "group_by": existing.get("group_by", "week")}

    def template():
        suggested = st.get("template") or existing.get("template") or DEFAULT_TEMPLATE
        st["template"], data = form.ask("template", "Path to the timesheet template (.xlsx)?", suggested,
                                        check=load_template)
        st["data"] = data
        n_cats = sum(len(p["categories"]) for p in data["projects"].values())
        shown = st["template"].replace(os.path.expanduser("~"), "~", 1)
        form.set("template", shown, f"({len(data['projects'])} projects, {n_cats} entry types)")
        if not form.live:
            print(f"  {GREEN}Found {len(data['projects'])} projects, {n_cats} entry types{RESET}\n")

        # Proposed defaults: keep previous choices where still valid
        projects = list(data["projects"])
        old = st.get("defaults") or existing.get("defaults", {})
        billable = [p for p in projects if data["projects"][p]["billable"] == "Yes"]
        project = old.get("project") if old.get("project") in projects else (billable or projects)[0]
        cats = data["projects"][project]["categories"]
        st["defaults"] = {
            "project": project,
            "category": cats[pick(cats, old.get("category"), pick(cats, "Software Development"))],
            "location": data["locations"][pick(data["locations"], old.get("location"),
                                               pick(data["locations"], "Home"))],
            "sentiment": data["sentiments"][pick(data["sentiments"], old.get("sentiment"),
                                                 pick(data["sentiments"], "Neutral"))],
        }

    def confirm():
        defaults, group_by = st["defaults"], st["group_by"]
        example = grouped_path(st["output"], group_by, dt.date.today())
        for key in ("project", "category", "location", "sentiment"):
            form.set(key, defaults[key])
        form.set("group_by", f"by {group_by}")
        form.set("output", example, "(e.g.)")
        if not form.live:
            print(f"{BOLD}Defaults:{RESET}")
            print(f"  Project     {CYAN}{defaults['project']}{RESET}")
            print(f"  Entry type  {CYAN}{defaults['category']}{RESET}")
            print(f"  Location    {CYAN}{defaults['location']}{RESET}")
            print(f"  Sentiment   {CYAN}{defaults['sentiment']}{RESET}")
            print(f"  Group files {CYAN}by {group_by}{RESET}")
            print(f"  Save to     {CYAN}{example}{RESET} {DIM}(e.g.){RESET}\n")
        answer = form.select(None, "Use these defaults?", ["Yes, save", "Change them"])
        return len(steps) if answer.startswith("Yes") else None

    def default_of(key, question, options):
        def step():
            st["defaults"][key] = form.select(key, question, options(), pick(options(), st["defaults"][key]))
        return step

    def group_by():
        st["group_by"] = ask_group_by(form, st["group_by"])

    def output():
        out = form.ask("output", "Save entries as? (the week/month is added to the name)", st["output"])
        st["output"] = out if out.lower().endswith(".xlsx") else out + ".xlsx"
        if not form.live:
            print()
        return steps.index(confirm)

    data = lambda: st["data"]
    steps = [
        template, confirm,
        default_of("project", "Default project?", lambda: list(data()["projects"])),
        default_of("category", "Default entry type?",
                   lambda: data()["projects"][st["defaults"]["project"]]["categories"]),
        default_of("location", "Default location?", lambda: data()["locations"]),
        default_of("sentiment", "Default sentiment?", lambda: data()["sentiments"]),
        group_by, output,
    ]
    form.run(steps)
    return st


# --- log entry -------------------------------------------------------------

ENTRY_FIELDS = [("day", "Day"), ("project", "Project"), ("category", "Entry type"),
                ("time", "Time"), ("location", "Location"), ("description", "Description")]


def check_duration(raw):
    minutes = parse_duration(raw) if raw else None
    if not (minutes and 0 < minutes <= 24 * 60):
        raise ValueError("Couldn't read that as a duration between 1 minute and 24 hours, try again.")
    return minutes


def log_entry(cfg):
    defaults = cfg["defaults"]
    today = dt.date.today()
    monday = today - dt.timedelta(days=today.weekday())
    days = [monday + dt.timedelta(days=i) for i in range(7)]
    labels = [f"{d:%A %d %b}" + ("  (today)" if d == today else "") for d in days]

    projects = list(cfg["projects"])
    st = {}

    def day():
        label = form.select("day", "Which day is the timesheet for?", labels,
                            pick(days, st.get("date"), today.weekday()))
        st["date"] = days[labels.index(label)]
        form.set("day", f"{st['date']:%A %d %b}")

    def project():
        st["project"] = form.select("project", "Which project?", projects,
                                    pick(projects, st.get("project"), pick(projects, defaults["project"])))

    def category():
        cats = cfg["projects"][st["project"]]["categories"]
        st["category"] = form.select("category", "What type of entry is it?", cats,
                                     pick(cats, st.get("category"), pick(cats, defaults["category"])))

    def time():
        # Rounded up to the next 15 minutes
        minutes = form.ask("time", "Total time spent? (e.g. 1:20, 1h20, 80m, 1.5)", st.get("time", ""),
                           check=check_duration)
        rounded = math.ceil(minutes / 15) * 15
        st["hours"], st["mins"] = divmod(rounded, 60)
        st["time"] = f"{st['hours']}h{st['mins']:02d}"
        note = f"(rounded up from {minutes // 60}h{minutes % 60:02d})" if rounded != minutes else ""
        form.set("time", st["time"], note)
        if not form.live:
            print(f"  {GREEN}{st['time']}{RESET}{f' {DIM}{note}{RESET}' if note else ''}")

    def location():
        st["location"] = form.select("location", "Where did you work from?", cfg["locations"],
                                     pick(cfg["locations"], st.get("location"),
                                          pick(cfg["locations"], defaults["location"])))

    def description():
        st["description"] = form.ask("description", "Description? (optional)", st.get("description", ""))

    with Form(ENTRY_FIELDS) as form:
        form.run([day, project, category, time, location, description])

    # Store
    date, hours, mins = st["date"], st["hours"], st["mins"]
    values = {
        "Date": date, "Project": st["project"], "Category": st["category"],
        "Hours": hours, "Minutes": mins, "Billable": cfg["projects"][st["project"]]["billable"],
        "Description": st["description"], "TicketNumber": "", "Sentiment": defaults["sentiment"],
        "WorkedFrom": st["location"],
    }
    path, = save_entries(cfg, [values])

    print(f"\n{GREEN}✔ Saved{RESET} {date:%a %d %b} · {st['project']} / {st['category']} · "
          f"{hours}h{mins:02d} · {st['location']}")
    print(f"{DIM}  → {path}{RESET}")


# --- hours summary ---------------------------------------------------------

HOURS_FLAGS = {"--hours-day": "day", "--hours-week": "week", "--hours-month": "month"}


def fmt_minutes(total):
    return f"{total // 60}h{total % 60:02d}"


def show_hours(cfg, period=None):
    """Logged time for today, this week or this month, per project and category, with a total."""
    if period is None:
        choices = {"Today": "day", "This week": "week", "This month": "month"}
        with Form([]) as form:
            period = choices[form.select(None, "Show hours for?", list(choices))]
        print(f"{DIM}Tip: osheet --hours-day, --hours-week or --hours-month skips this question{RESET}\n")

    today = dt.date.today()
    if period == "day":
        start = end = today
        title, span = "Today", f"({today:%a %d %b})"
    elif period == "week":
        start = today - dt.timedelta(days=today.weekday())
        end = start + dt.timedelta(days=6)
        title, span = "This week", f"({start:%a %d %b} – {end:%a %d %b})"
    else:
        start = today.replace(day=1)
        end = (start + dt.timedelta(days=32)).replace(day=1) - dt.timedelta(days=1)
        title, span = "This month", f"({start:%B %Y})"
    dates = [start + dt.timedelta(days=i) for i in range((end - start).days + 1)]

    # A week or month can span several files; each holds only entries from its own period
    totals = {}
    for path in dict.fromkeys(output_path(cfg, d) for d in dates):
        if not os.path.exists(path):
            continue
        for e in read_entries(path):
            if start <= e["Date"] <= end:
                cats = totals.setdefault(e.get("Project", "?"), {})
                cat = e.get("Category", "?")
                cats[cat] = cats.get(cat, 0) + e["Hours"] * 60 + e["Minutes"]

    if not totals:
        print(f"{BOLD}{title} {DIM}{span}{RESET}\n")
        print(f"{DIM}  No entries logged {'today' if period == 'day' else 'this ' + period} yet.{RESET}")
        return
    # Boxed table: one group per project (busiest first), with a subtotal when it has several categories
    groups = []
    for project, cats in sorted(totals.items(), key=lambda kv: -sum(kv[1].values())):
        rows = [(project if i == 0 else "", cat, fmt_minutes(mins), "")
                for i, (cat, mins) in enumerate(sorted(cats.items(), key=lambda kv: -kv[1]))]
        if len(rows) > 1:
            rows.append(("", "Subtotal", fmt_minutes(sum(cats.values())), BOLD))
        groups.append(rows)
    total = ("Total", "", fmt_minutes(sum(sum(c.values()) for c in totals.values())), BOLD + GREEN)
    header = ("Project", "Category", "Time", BOLD)
    widths = [max(len(r[i]) for g in groups + [[header, total]] for r in g) for i in range(3)]
    heading = f"{title} {span}"
    widths[1] += max(0, len(heading) - (sum(widths) + 6))  # widen so the heading row fits

    def rule(left, mid, right):
        return f"  {DIM}{left}{mid.join('─' * (w + 2) for w in widths)}{right}{RESET}"

    def line(project, cat, time, style):
        bar = f"{DIM}│{RESET}"
        cells = [f"{project:<{widths[0]}}", f"{cat:<{widths[1]}}", f"{time:>{widths[2]}}"]
        if style and not project:  # subtotal: highlight only the category and time
            cells[1:] = [f"{style}{c}{RESET}" for c in cells[1:]]
        elif style:
            cells = [f"{style}{c}{RESET}" for c in cells]
        elif project:
            cells[0] = f"{BOLD}{cells[0]}{RESET}"
        return f"  {bar} " + f" {bar} ".join(cells) + f" {bar}"

    inner = sum(widths) + 6
    print(f"  {DIM}╭{'─' * (inner + 2)}╮{RESET}")
    pad = inner - len(heading)
    print(f"  {DIM}│{RESET} {' ' * (pad // 2)}{BOLD}{title}{RESET} {DIM}{span}{RESET}{' ' * (pad - pad // 2)} {DIM}│{RESET}")
    print(rule("├", "┬", "┤"))
    print(line(*header))
    for rows in groups:
        print(rule("├", "┼", "┤"))
        for row in rows:
            print(line(*row))
    print(rule("├", "┼", "┤"))
    print(line(*total))
    print(rule("╰", "┴", "╯"))

def copy_to_clipboard(text):
    """Copy text using the platform's clipboard tool. Returns the tool used, or None."""
    if sys.platform == "darwin":
        candidates = [["pbcopy"]]
    elif sys.platform == "win32":
        candidates = [["clip"]]
    else:
        candidates = []
        if os.environ.get("WAYLAND_DISPLAY"):
            candidates.append(["wl-copy"])
        candidates += [["xclip", "-selection", "clipboard"], ["xsel", "--clipboard", "--input"]]
    for cmd in candidates:
        if shutil.which(cmd[0]):
            try:
                subprocess.run(cmd, input=text.encode(), check=True, timeout=5,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return cmd[0]
            except (OSError, subprocess.SubprocessError):
                continue
    return None


def show_dir(cfg):
    folder = os.path.dirname(output_path(cfg, dt.date.today()))
    url = "file://" + urllib.parse.quote(folder.replace(os.sep, "/"))
    # OSC 8 hyperlink: clickable in most modern terminals, plain text elsewhere
    print(f"\033]8;;{url}\033\\{BOLD}{folder}{RESET}\033]8;;\033\\")
    if not os.path.isdir(folder):
        print(f"{DIM}  (doesn't exist yet; it's created when you log your first entry){RESET}")
    tool = copy_to_clipboard(folder)
    if tool:
        print(f"{GREEN}✔ Copied folder path to clipboard{RESET}")
    else:
        print(f"{DIM}  No clipboard tool found (install wl-clipboard, xclip or xsel); copy the path above.{RESET}")


def main(argv):
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__.strip())
        return
    cfg = load_config()
    if cfg is not None and "group_by" not in cfg:
        with Form([("group_by", "Group files")]) as form:
            cfg["group_by"] = ask_group_by(form)
        save_config(cfg)
        print()
    if cfg is not None:
        cfg = migrate_csv(cfg)
        migrate_ungrouped(cfg)
    if cfg is None or "--setup" in argv:
        if cfg is None:
            print("No config found, let's set osheet up first.\n")
        setup(cfg)
        return
    if "--export" in argv:
        show_dir(cfg)
        return
    if "--hours" in argv or any(a in HOURS_FLAGS for a in argv):
        show_hours(cfg, next((HOURS_FLAGS[a] for a in argv if a in HOURS_FLAGS), None))
        return
    log_entry(cfg)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (KeyboardInterrupt, EOFError):
        print("\nCancelled, nothing saved.")
        sys.exit(130)
